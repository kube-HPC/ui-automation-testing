{
  "name": "ui-automation-testing",
  "version": "1.0.0",
  "description": "automation testing Playwright for ui tests",
  "main": "index.js",
  "scripts": {
    "setup": "npm install && npx playwright install && npm run hooks:install || true",
    "test": "npx playwright test",
    "report": "npx playwright show-report",
    "codegen": "node scripts/codegen.mjs",
    "check:empty-files": "node scripts/check-empty-spec-files.mjs",
    "check:empty-specs": "npm run check:empty-files",
    "check:test-naming": "node scripts/check-test-folder-naming.mjs",
    "check:test-titles": "node scripts/check-test-title-policy.mjs",
    "check:test-structure": "npm run check:empty-files && npm run check:test-naming && npm run check:test-titles",
    "hooks:install": "node scripts/install-pre-commit-hook.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kube-HPC/ui-automation-testing.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kube-HPC/ui-automation-testing/issues"
  },
  "homepage": "https://github.com/kube-HPC/ui-automation-testing#readme",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "dotenv": "^17.3.1"
  },
  "dependencies": {
    "axios": "^1.13.6"
  }
}
