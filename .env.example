# Copy this file to `.env` and fill in real values for your environment.
# `.env` is git-ignored and stays local to your machine.
#
# In CI, these values come from GitHub Secrets (see .github/workflows/playwright.yml).

# Root of the HKube deployment. The dashboard and backend URLs are derived from it.
BASE_URL="??"

# Keycloak credentials used for UI login and API auth.
KEYCLOAK_USERNAME=??
KEYCLOAK_PASSWORD=??

# Optional overrides:
# Keycloak auth is enabled by default. Set to false to run against a non-auth deployment.
# VITE_KEYCLOAK_ENABLE=false
# Prefix applied to test-created resources (defaults to "pw-").
# PREFIX="pw-"
